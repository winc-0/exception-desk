# docker compose 使用。复制为 .env 后填写，不要提交到 Git。
# 生成随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"

# 密码会写进数据库连接串，请只用字母、数字、- 和 _
POSTGRES_PASSWORD=
DESK_APP_PASSWORD=
DESK_JWT_SECRET=

# 工作台对外的地址，要和浏览器地址栏一致，多个用逗号分隔
DESK_ALLOWED_ORIGINS=https://desk.example.com

# 只有在本机用 http 试运行时才改成 false
DESK_COOKIE_SECURE=true
DESK_HTTP_PORT=8080

# AI 回复草稿用的模型，OpenAI 兼容接口。都留空时退回到模板，其他功能不受影响
DESK_LLM_BASE_URL=
DESK_LLM_API_KEY=
DESK_LLM_MODEL=
DESK_EMBEDDING_MODEL=text-embedding-v3

# 只有叠加 docker-compose.registry.yml 时才用，形如 registry.example.com/namespace
DESK_IMAGE_PREFIX=
DESK_IMAGE_TAG=latest
